model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup '01 Parameters'

	annotation PBI_QueryGroupOrder = 0

queryGroup '02 Source'

	annotation PBI_QueryGroupOrder = 1

queryGroup '03 Staging'

	annotation PBI_QueryGroupOrder = 2

queryGroup '04 Intermediate'

	annotation PBI_QueryGroupOrder = 3

queryGroup '05 Output'

	annotation PBI_QueryGroupOrder = 4

queryGroup '06 Quality Checks'

	annotation PBI_QueryGroupOrder = 5

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["DataFolder","src_DataFolder","stg_TMS","stg_Hierarchy","stg_Subledger","int_Level1","int_Level2","Check_ShareTotals","out_ExpectedBalances","int_SubledgerTotals","out_Reconciliation","Check_UnmappedPositions","_measures"]

ref table stg_TMS
ref table stg_Hierarchy
ref table stg_Subledger
ref table Check_ShareTotals
ref table out_ExpectedBalances
ref table out_Reconciliation
ref table Check_UnmappedPositions
ref table _measures

ref cultureInfo en-US

